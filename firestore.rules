rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Users collection
    match /users/{userId} {
      // Allow reading any user profile (for contact info, claim reviews, etc.)
      allow get, list: if isAuthenticated();
      // Users can create/update their own profile, or admins can update any profile
      allow create, update: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
      // Admins can delete any user
      allow delete: if isAdmin();
    }
    
    // Items collection
    match /items/{itemId} {
      // Anyone authenticated can read any item (includes both get and list/query operations)
      allow read: if isAuthenticated();
      // Anyone authenticated can create items (must be owner)
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      // Users can update their own items, or admins can update any item
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
      // Users can delete their own items, or admins can delete any item
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
    }
    
    // Claims collection
    match /claims/{claimId} {
      // Users can read all claims
      allow read: if isAuthenticated();
      // Users can create claims
      allow create: if isAuthenticated() && request.resource.data.claimantId == request.auth.uid;
      // Users can update their own claims, OR item owners can update claims for their items
      allow update: if isAuthenticated() && (
        resource.data.claimantId == request.auth.uid ||
        // Allow if user is the owner of the item being claimed
        // We need to check the item's ownerId matches the current user
        // This requires a get() call to fetch the item document
        get(/databases/$(database)/documents/items/$(resource.data.itemId)).data.ownerId == request.auth.uid
      );
    }
    
    // Notifications collection - subcollection structure: notifications/{userId}/items/{notificationId}
    match /notifications/{userId}/items/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Any authenticated user can create notifications for any user (needed for claim notifications, messages, etc.)
      // This is safe because:
      // 1. Only authenticated users can create
      // 2. Users can only read their own notifications
      // 3. The notification content is controlled by application code
      allow create: if isAuthenticated();
      // Users can update their own notifications (e.g., mark as read)
      allow update: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Chats collection - structure: chats/{chatId}/messages/{messageId}
    match /chats/{chatId} {
      // Users can read chat metadata if they are a participant (or if document doesn't exist yet, allow if they're in the participants array being created)
      allow read: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/chats/$(chatId)) ||
        request.auth.uid in resource.data.participants
      );
      // Users can create/update chat metadata if they are a participant
      // For create: check if user is in the participants array being set
      // For update: check if user is in the participants array being set (merge operations)
      allow create: if isAuthenticated() && 
        request.resource.data.participants != null &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && (
        // Allow if user is in the participants array being set
        (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants) ||
        // Or if user is already in existing participants (for merge operations that don't change participants)
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      );
      
      // Messages subcollection
      match /messages/{messageId} {
        // Users can read messages if they are a participant in the chat
        // Handle case where chat document might not exist yet (new chat)
        allow read: if isAuthenticated() && (
          !exists(/databases/$(database)/documents/chats/$(chatId)) ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        // Users can create messages if they are the sender
        // Also allow if chat doesn't exist yet (will be created with the message)
        allow create: if isAuthenticated() && 
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.receiverId != null;
        // Users can update their own messages or messages sent to them
        allow update: if isAuthenticated() && 
          (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      }
    }
  }
}
